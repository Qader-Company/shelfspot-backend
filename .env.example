APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Public download or sign-in URL for the worker application.
WORKER_APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# API: send Accept-Language: ar or header X-Locale: ar for Arabic OTP emails
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use `reverb` in an environment where `php artisan reverb:start` is running.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Comma-separated browser origins allowed to call the API and broadcast auth endpoint.
FRONTEND_ORIGINS=http://localhost:5173
# Queue workers should consume these queues separately in production.
NOTIFICATIONS_HIGH_QUEUE=notifications-high
NOTIFICATIONS_NORMAL_QUEUE=notifications-normal
NOTIFICATIONS_BROADCAST_QUEUE=broadcasts
NOTIFICATIONS_QUEUE_TRIES=3
NOTIFICATIONS_QUEUE_MAX_PENDING=100
NOTIFICATIONS_REVERB_HEALTH_TIMEOUT=2

CACHE_STORE=database
# CACHE_PREFIX=

# Redis caching module. Enable Redis with CACHE_STORE=redis when Redis is provisioned.
# SHELSPOT_CACHE_STORE=redis
SHELSPOT_CACHE_ENABLED=true
SHELSPOT_CACHE_REPORTS_ENABLED=false
SHELSPOT_CACHE_CATALOG_ENABLED=false
SHELSPOT_CACHE_PLATFORM_SETTINGS_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Development: log writes mail to storage/logs/laravel.log
# Production: use smtp and set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OTP validity in minutes (email copy uses this value)
OTP_TTL=10

# Rate limiting (auth routes; uses CACHE_STORE)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_DECAY=1
RATE_LIMIT_REGISTER=3
RATE_LIMIT_REGISTER_DECAY=60
RATE_LIMIT_OTP_SEND_EMAIL=3
RATE_LIMIT_OTP_SEND_IP=10
RATE_LIMIT_OTP_SEND_DECAY=1
RATE_LIMIT_OTP_VERIFY=10
RATE_LIMIT_OTP_VERIFY_DECAY=1
RATE_LIMIT_RESET_PASSWORD=5
RATE_LIMIT_RESET_PASSWORD_DECAY=1
RATE_LIMIT_REFRESH=30
RATE_LIMIT_REFRESH_DECAY=1
RATE_LIMIT_LOGOUT=60
RATE_LIMIT_LOGOUT_DECAY=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

APP_IMAGE=shelfspot-app:local
NGINX_IMAGE=shelfspot-nginx:local
